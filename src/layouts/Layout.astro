---
import "../styles/reset.css";
import "../styles/globals.css";

import { name, themeColor, twitterHandle } from "spectre:globals";
import Background from "../components/Background.astro";
import Card from "../components/Card.astro";
import LayoutGrid from "../components/LayoutGrid.astro";
import Navbar from "../components/Navbar.astro";

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata;
	pagefindIgnore?: boolean;
	article?: {
		createdAt: Date;
		updatedAt?: Date;
	};
}

const { title, description, image, pagefindIgnore, article } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<script is:inline>
			const LIGHT_THEME_HOURS = { start: 7, end: 19 };
			const THEME_COLORS = {
				light: "#f6efe3",
				dark: "#0b0b0b",
			};

			const getThemeForCurrentTime = () => {
				const hour = new Date().getHours();

				return hour >= LIGHT_THEME_HOURS.start && hour < LIGHT_THEME_HOURS.end
					? "light"
					: "dark";
			};

			const applyTheme = () => {
				const theme = getThemeForCurrentTime();
				const root = document.documentElement;
				const updateThemeColor = () => {
					const themeColorMeta = document.querySelector('meta[name="theme-color"]');

					themeColorMeta?.setAttribute("content", THEME_COLORS[theme]);
				};

				root.dataset.theme = theme;
				root.style.colorScheme = theme;
				updateThemeColor();
				document.addEventListener("DOMContentLoaded", updateThemeColor, {
					once: true,
				});

				window.dispatchEvent(
					new CustomEvent("themechange", {
						detail: { theme },
					}),
				);
			};

			const scheduleThemeRefresh = () => {
				const now = new Date();
				const nextBoundary = new Date(now);
				const isLightTheme = getThemeForCurrentTime() === "light";

				nextBoundary.setHours(
					isLightTheme ? LIGHT_THEME_HOURS.end : LIGHT_THEME_HOURS.start,
					0,
					0,
					0,
				);

				if (nextBoundary <= now) {
					nextBoundary.setDate(nextBoundary.getDate() + 1);
				}

				window.setTimeout(() => {
					applyTheme();
					scheduleThemeRefresh();
				}, nextBoundary.getTime() - now.getTime());
			};

			applyTheme();
			scheduleThemeRefresh();
		</script>
		<link rel="preload" href="/fonts/Geist.woff2" as="font" type="font/woff2" crossorigin="">
		<link rel="preload" href="/fonts/GeistMono.woff2" as="font" type="font/woff2" crossorigin="">
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
			integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
			crossorigin="anonymous"
		/>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<meta name="theme-color" content={themeColor}>

		<link rel="canonical" href={Astro.url} />

		<meta name="og:title" content={title} />
		{description && <meta name="og:description" content={description} />}
		<meta name="og:image" content={image?.src || '/img/fat_fire.png'} />
		<meta name="og:url" content={Astro.site} />
		{!article && <meta name="og:type" content="website" />}
		<meta name="og:locale" content="en" />

		{article && (
			<meta name="og:type" content="article" />
			<meta property="article:published_time" content={article.createdAt.toISOString()} />
			<meta name="author" content={name} />
		)}

		{article && article.updatedAt && (
			<meta property="article:modified_time" content={article.updatedAt.toISOString()} />
		)}

		<meta name="twitter:card" content="summary_large_image" />
		{twitterHandle && (
			<meta name="twitter:site" content={twitterHandle} />
			<meta name="twitter:creator" content={twitterHandle} />
		)}
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={image?.src || '/img/fat_fire.png'} />
	</head>
	<body>
		<header class="header-container">
			<Card class="topbar-card">
				<Navbar />
			</Card>
			
			<Card class="disclaimer-card">
				<p class="disclaimer-text">
					<strong>Disclaimer:</strong> I am not a financial advisor. The content on this blog is for educational and documentary purposes only. It does not constitute professional financial, investment, or legal advice. Investing involves risk, and you should perform your own due diligence or consult a licensed professional before making any financial decisions. 
					<a href="/disclaimer" class="disclaimer-link">Learn more</a>.
				</p>
			</Card>
		</header>

		<main data-pagefind-ignore={pagefindIgnore} class="relative z-10">
			<LayoutGrid>
				<slot name="left" slot="left" />
				<slot name="right" slot="right" />
			</LayoutGrid>
			<slot name="404" />
		</main>
		<Background />
	</body>
</html>
